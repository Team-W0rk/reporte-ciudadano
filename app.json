{
  "expo": {
    "name": "Reporte Ciudadano",
    "slug": "reporte-ciudadano",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reporteciudadano",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Se usa la cámara para sacar la foto obligatoria de cada reporte.",
        "NSLocationWhenInUseUsageDescription": "Se usa tu ubicación para marcar dónde está el problema reportado.",
        "NSMicrophoneUsageDescription": "Se usa el micrófono para grabar la nota de voz del reporte.",
        "NSFaceIDUsageDescription": "Usá Face ID para volver a entrar a tu cuenta rápido."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Se usa la cámara para sacar la foto obligatoria de cada reporte.",
          "microphonePermission": "Se usa el micrófono para grabar la nota de voz del reporte."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Se usa tu ubicación para marcar dónde está el problema reportado."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Se usa la galería para adjuntar una foto ya sacada."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1B6CA8"
        }
      ],
      "expo-audio",
      "expo-image",
      "expo-secure-store",
      "expo-sqlite",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
